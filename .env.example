# --- PayPal (sandbox) --- https://developer.paypal.com/dashboard/applications/sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
PAYPAL_WEBHOOK_ID=
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
# Prices are in INR. PayPal settles Indian accounts in USD, so orders are converted at this rate.
# Set PAYPAL_CURRENCY=INR only if both sandbox accounts are registered in India.
PAYPAL_CURRENCY=USD
INR_PER_USD=88
# Your sandbox Business account email. Milestone payments are captured to it.
DEMO_FREELANCER_PAYPAL_EMAIL=

# --- AI --- https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# --- Database (Neon Postgres) --- https://console.neon.tech
# Pooled connection string. Leave empty to store data in data/db.json instead.
DATABASE_URL=

# --- Optional: raises GitHub API rate limit for the work verifier ---
GITHUB_TOKEN=

# Leave the PayPal / Gemini keys empty to run locally with simulated PayPal and rule-based AI.
